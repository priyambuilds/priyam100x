# Local docker-compose services (bun run services:up)
DATABASE_URL="postgres://chat:chat@localhost:5432/chat"
REDIS_URL="redis://localhost:6379"

# Required, >= 16 chars. Generate: openssl rand -base64 48
JWT_SECRET=""

PORT=3000
# JWT_TTL_SECONDS=3600
# Comma-separated browser origins allowed to open a WebSocket (empty = don't enforce)
# ALLOWED_ORIGINS="http://localhost:5173"
# MSG_RATE_MAX=20
# MSG_RATE_WINDOW_SECONDS=10

# --- Redis scaling (optional) ---
# Sharded Pub/Sub on a single Redis 7 node:
# REDIS_SHARDED=true
# Redis Cluster (implies sharded Pub/Sub; REDIS_URL is ignored). Local: bun run services:cluster
# REDIS_CLUSTER_NODES="127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003"
