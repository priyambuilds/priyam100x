generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomKind {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  members  RoomMember[]
  messages Message[]
}

model Room {
  id        String   @id @default(uuid())
  kind      RoomKind
  name      String?
  // "<smallerUserId>:<largerUserId>" for DIRECT rooms; the unique key stops two
  // concurrent "start DM" calls from creating two rooms.
  dmKey     String?  @unique
  // Highest seq handed out. Bumped inside the insert transaction.
  lastSeq   Int      @default(0)
  createdAt DateTime @default(now())

  members  RoomMember[]
  messages Message[]
}

model RoomMember {
  roomId      String
  userId      String
  role        MemberRole @default(MEMBER)
  lastReadSeq Int        @default(0)
  joinedAt    DateTime   @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model Message {
  id          String   @id @default(uuid())
  roomId      String
  seq         Int
  senderId    String
  clientMsgId String   @db.Uuid
  body        String
  createdAt   DateTime @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Ordering + the keyset-pagination index.
  @@unique([roomId, seq])
  // Idempotent retries.
  @@unique([senderId, clientMsgId])
}
