generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TransactionType {
  TOP_UP
  BOOKING
  REFUND
}

enum TransactionStatus {
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  wallet       Wallet?
  bookings     Booking[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id       String    @id @default(uuid())
  name     String    @unique
  theatres Theatre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Theatre {
  id     String @id @default(uuid())
  name   String @unique
  cityId String

  city    City     @relation(fields: [cityId], references: [id])
  screens Screen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, name])
  @@index([cityId])
}

model Screen {
  id        String @id @default(uuid())
  name      String
  theatreId String

  theatre   Theatre    @relation(fields: [theatreId], references: [id])
  seats     Seats[]
  showtimes ShowTime[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([theatreId, name])
  @@index([theatreId])
}

model Seats {
  number   Int
  screenId String

  screen       Screen        @relation(fields: [screenId], references: [id])
  bookingSeats BookingSeat[]

  @@id([screenId, number])
  @@unique([screenId, number])
  @@index([screenId])
}

model Movie {
  id          String @id @default(uuid())
  title       String
  description String
  durationMin Int

  showtimes ShowTime[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShowTime {
  id         String   @id @default(uuid())
  movieId    String
  screenId   String
  startsAt   DateTime
  endsAt     DateTime
  priceCents Int

  movie    Movie     @relation(fields: [movieId], references: [id])
  screen   Screen    @relation(fields: [screenId], references: [id])
  bookings Booking[]

  createdAt    DateTime      @default(now())
  bookingSeats BookingSeat[]

  @@unique([screenId, startsAt])
  @@index([screenId, startsAt])
  @@index([movieId, startsAt])
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  showtimeId String
  status     BookingStatus @default(PENDING)
  totalCents Int

  user        User          @relation(fields: [userId], references: [id])
  showtime    ShowTime      @relation(fields: [showtimeId], references: [id])
  seats       BookingSeat[]
  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, createdAt])
  @@index([showtimeId])
}

model BookingSeat {
  id         String @id @default(uuid())
  bookingId  String
  showtimeId String
  screenId   String
  seatNumber Int

  booking  Booking  @relation(fields: [bookingId], references: [id])
  showtime ShowTime @relation(fields: [showtimeId], references: [id])
  seat     Seats    @relation(fields: [screenId, seatNumber], references: [screenId, number])

  @@unique([showtimeId, screenId, seatNumber])
  @@index([bookingId])
}

model Wallet {
  id           String @id @default(uuid())
  userId       String @unique
  balanceCents Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id                 String            @id @default(uuid())
  userId             String
  bookingId          String?           @unique
  type               TransactionType
  amountCents        Int
  balanceBeforeCents Int
  balanceAfterCents  Int
  status             TransactionStatus

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
