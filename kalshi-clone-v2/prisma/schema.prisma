// The database has several different kinds of rules:
// | Rule                                                       | Mechanism                              |
// |------------------------------------------------------------|----------------------------------------|
// | Every wallet belongs to an existing user                   | Foreign key                            |
// | A user has at most one wallet                              | Unique constraint                      |
// | A user has at most one position per market and outcome     | Compound unique constraint             |
// | Reserved cash cannot exceed owned cash                     | Check constraint                       |
// | Cash, contracts, and escrow change together during a split | Transaction—we’ll implement this later |

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Outcome {
  YES
  NO
}

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
}

enum WalletEntryType {
  DEPOSIT
  SPLIT
  MERGE
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  FILLED
  OPEN
  CANCELLED
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
  role     Role   @default(USER)

  positions      Position[]
  wallet         Wallet?
  createdMarkets Market[]
  orders         Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // reserving 300¢ changes lockedCents but does not reduce balanceCents
  balanceCents Int @default(0)
  lockedCents  Int @default(0)

  entries WalletEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletEntry {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type        WalletEntryType
  amountCents Int
  requestId   String

  marketId String?
  market   Market? @relation(fields: [marketId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  // One wallet can have at most one entry with a particular request ID.
  @@unique([walletId, requestId])
  @@index([walletId, createdAt])
}

model Market {
  id          String       @id @default(uuid())
  title       String
  description String?
  creatorId   String
  creator     User         @relation(fields: [creatorId], references: [id])
  status      MarketStatus @default(OPEN)
  resolution  Outcome? // resolution Outcome? means the result can be unknown. We dont need a seperate PENDING outcome

  resolutionCriteria String
  resolutionSource   String

  closesAt   DateTime
  resolvedAt DateTime?

  outstandingPairs Int @default(0)
  escrowCents      Int @default(0)

  positions     Position[]
  walletEntries WalletEntry[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, closesAt])
}

model Position {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  outcome Outcome

  quantity       Int @default(0)
  lockedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The position constraint means one row per user, market, and outcome.
  // @@unique([userId, marketId, outcome])
  // Alice can have:
  // Alice + Market A + YES → one position row
  // Alice + Market A + NO  → one position row
  // Alice + Market B + YES → another position row
  // She cannot have two separate position rows for Alice + Market A + YES. 
  // When she buys more YES in Market A, we increase the existing row’s quantity.
  @@unique([userId, marketId, outcome])
  @@index([marketId, outcome])
}

model Order {
  id      String @id @default(uuid())
  // sequence will break ties between orders at the same price
  // We create orders while holding the market lock, so within one market a 
  // lower sequence means the exchange accepted that order first.
  sequence Int @unique @default(autoincrement()) @map("squence")

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  side              OrderSide
  outcome           Outcome
  limitPriceCents   Int
  quantity          Int
  remainingQuantity Int
  status            OrderStatus @default(OPEN)

  requestId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, marketId, requestId])
}
